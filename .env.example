NEXUSS_ENV=development
NEXUSS_LOG_LEVEL=INFO
NEXUSS_DATABASE_URL=postgresql://nexuss:nexuss@localhost:5432/nexuss
NEXUSS_REQUIRE_SIGNED_DEVICE_CALLS=true
NEXUSS_ATS_MODE=read_only
